# Supabase sync (optional — without these the app runs local-only).
# Copy to .env.local (gitignored) and fill in from your Supabase project:
# Dashboard → Project Settings → API. The anon key is publishable, not a secret,
# but keep real values out of git anyway.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
